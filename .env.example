# ===== 大模型服务配置（OpenAI 兼容协议） =====
# 任选一个国内/外大模型填入即可，三个示例见 README。

# 你的大模型 API 密钥（必填）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 接口地址（OpenAI 兼容）。留空则使用 OpenAI 官方端点。
# DeepSeek:   https://api.deepseek.com
# GLM(智谱):  https://open.bigmodel.cn/api/paas/v4
# Qwen(通义): https://dashscope.aliyuncs.com/compatible-mode/v1
# CC-SWITCH:  http://127.0.0.1:<端口>/v1
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（与上面接口匹配）
# DeepSeek: deepseek-chat   GLM: glm-4-flash   Qwen: qwen-plus
LLM_MODEL=deepseek-chat

# ===== 数据库配置（多用户信息管理系统） =====
# 数据库后端：sqlite（默认，本地开箱即用） 或 supabase（部署到 Vercel 时）
DB_BACKEND=sqlite

# SQLite 数据库文件路径（仅 DB_BACKEND=sqlite 时生效）
DB_PATH=data/app.db

# 登录会话有效期（小时）
SESSION_TTL_HOURS=72

# Supabase 配置（仅 DB_BACKEND=supabase 时生效，部署到 Vercel 时使用）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
